#!/usr/bin/env bash
# meta-notes - command line interface for meta-notes
# Resolves symlinks so the shim can be linked onto PATH.
#
# Runs the CLI with the notes root's virtualenv (<root>/.venv/bin/python3)
# when it's executable, otherwise with python3 on PATH. The root is found as
# the CLI finds it: --root, then META_NOTES_ROOT, then an upward search for
# .meta-notes that stops after $HOME. This only picks the interpreter; the
# CLI still resolves the root itself. init always runs on python3: it has
# its own root rules, and --force deletes the virtualenv.

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
plugin="$(cd -P "$(dirname "$src")/.." && pwd)"
main="$plugin/scripts/meta_notes/__main__.py"

command=""
root=""
skip=""
for arg in "$@"; do
  if [ -n "$skip" ]; then
    root="$arg"
    skip=""
    continue
  fi
  case "$arg" in
    --root) skip=1 ;;
    --root=*) root="${arg#--root=}" ;;
    -*) ;;
    *) [ -z "$command" ] && command="$arg" ;;
  esac
done

if [ "$command" = "init" ]; then
  exec python3 "$main" "$@"
fi

if [ -z "$root" ]; then
  root="$META_NOTES_ROOT"
fi

if [ -z "$root" ]; then
  home=""
  [ -n "$HOME" ] && home="$(cd -P "$HOME" 2>/dev/null && pwd)"
  dir="$(pwd -P)"
  while :; do
    if [ -f "$dir/.meta-notes" ]; then
      root="$dir"
      break
    fi
    if [ "$dir" = "$home" ] || [ "$dir" = "/" ]; then
      break
    fi
    dir="$(dirname "$dir")"
  done
fi

if [ -n "$root" ]; then
  root="${root/#\~/$HOME}"
  if [ -f "$root/.venv/bin/python3" ] && [ -x "$root/.venv/bin/python3" ]; then
    exec "$root/.venv/bin/python3" "$main" "$@"
  fi
fi

exec python3 "$main" "$@"
