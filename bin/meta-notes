#!/usr/bin/env bash
# meta-notes - command line interface for meta-notes
# Resolves symlinks so the shim can be linked onto PATH.

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"

exec python3 "$root/scripts/meta_notes/__main__.py" "$@"
