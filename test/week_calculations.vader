" Tests for week start/end calculation functions

Execute (Test CalculateWeekStart - Monday returns same day):
  let result = meta_notes#notes#CalculateWeekStart('2026-02-09')
  AssertEqual '2026-02-09', result

Execute (Test CalculateWeekStart - Tuesday returns previous Monday):
  let result = meta_notes#notes#CalculateWeekStart('2026-02-10')
  AssertEqual '2026-02-09', result

Execute (Test CalculateWeekStart - Friday returns previous Monday):
  let result = meta_notes#notes#CalculateWeekStart('2026-02-13')
  AssertEqual '2026-02-09', result

Execute (Test CalculateWeekStart - Sunday returns previous Monday):
  let result = meta_notes#notes#CalculateWeekStart('2026-02-15')
  AssertEqual '2026-02-09', result

Execute (Test CalculateWeekEnd - Sunday returns same day):
  let result = meta_notes#notes#CalculateWeekEnd('2026-02-15')
  AssertEqual '2026-02-15', result

Execute (Test CalculateWeekEnd - Monday returns following Sunday):
  let result = meta_notes#notes#CalculateWeekEnd('2026-02-09')
  AssertEqual '2026-02-15', result

Execute (Test CalculateWeekEnd - Friday returns following Sunday):
  let result = meta_notes#notes#CalculateWeekEnd('2026-02-13')
  AssertEqual '2026-02-15', result

Execute (Test CalculateWeekEnd - Saturday returns next day):
  let result = meta_notes#notes#CalculateWeekEnd('2026-02-14')
  AssertEqual '2026-02-15', result

Execute (Test OpenWeekPlan creates file with correct path):
  " Clean up any existing file first
  silent! call delete('resource/plan/week/Plan 2026-02-09.md')

  " Open week plan for a Friday (should create Monday's plan)
  call meta_notes#notes#OpenWeekPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/week/Plan 2026-02-09.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Week Plan - 2026-02-09', first_line

  " Clean up
  silent! call delete('resource/plan/week/Plan 2026-02-09.md')

Execute (Test MetaNotesWeekPlan command with date argument):
  " Clean up any existing file first
  silent! call delete('resource/plan/week/Plan 2026-02-09.md')

  " Use the command with a date argument
  MetaNotesWeekPlan 2026-02-13

  " Verify we're in the correct file
  AssertEqual 'resource/plan/week/Plan 2026-02-09.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Week Plan - 2026-02-09', first_line

  " Clean up
  silent! call delete('resource/plan/week/Plan 2026-02-09.md')
