" Tests for meta_notes#notes#GetTextWithinDelimiters function

Execute (Load plugin):
  runtime plugin/meta_notes.vim

" ============================================================================
" Double Square Brackets [[text]] - Primary delimiter type
" ============================================================================

Given markdown (Wiki-style link):
  See related: [[note/path/Filename]] here

Execute (Cursor positions - inside, on delimiters, outside):
  " Inside text
  call cursor(1, 20)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " On opening delimiter
  call cursor(1, 15)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " On closing delimiter
  call cursor(1, 35)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " Before opening
  call cursor(1, 10)
  AssertEqual '', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " After closing
  call cursor(1, 36)
  AssertEqual '', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')

Given markdown (Multiple links):
  Links: [[first/link]] and [[second/link]] here

Execute (Multiple delimiters on same line):
  call cursor(1, 12)
  AssertEqual 'first/link', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  call cursor(1, 32)
  AssertEqual 'second/link', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  call cursor(1, 25)
  AssertEqual '', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')

Given markdown (Edge cases):
  [[at-start]] [[x]] Text [[at-end]]

Execute (Edge cases - position and length):
  " At start of line
  call cursor(1, 3)
  AssertEqual 'at-start', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " Single character
  call cursor(1, 17)
  AssertEqual 'x', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  " At end of line
  call cursor(1, 30)
  AssertEqual 'at-end', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')

Given markdown (Special characters):
  Link: [[path/to/file_v2.1-beta]] here

Execute (Special characters in content):
  call cursor(1, 15)
  AssertEqual 'path/to/file_v2.1-beta', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')

" ============================================================================
" Other Delimiter Types - Basic tests only
" ============================================================================

Given markdown (Single brackets):
  Reference: [some-tag] here

Execute (Single brackets work):
  call cursor(1, 15)
  AssertEqual 'some-tag', meta_notes#notes#GetTextWithinDelimiters('[', ']')

Given markdown (Angle brackets):
  Visit <http://example.com?foo=bar> for details

Execute (Angle brackets work):
  call cursor(1, 15)
  AssertEqual 'http://example.com?foo=bar', meta_notes#notes#GetTextWithinDelimiters('<', '>')

Given markdown (Parentheses):
  Click [here](https://example.com/page) to continue

Execute (Parentheses work):
  call cursor(1, 20)
  AssertEqual 'https://example.com/page', meta_notes#notes#GetTextWithinDelimiters('(', ')')

Given markdown (Pipes):
  Table cell: |important data| and more

Execute (Pipes work):
  call cursor(1, 20)
  AssertEqual 'important data', meta_notes#notes#GetTextWithinDelimiters('|', '|')

" ============================================================================
" Mixed Delimiters
" ============================================================================

Given markdown (Mixed delimiters):
  Mixed: [[wiki/link]] and <http://url.com> and (parens)

Execute (Mixed delimiters - each type extracts correctly):
  call cursor(1, 12)
  AssertEqual 'wiki/link', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  call cursor(1, 30)
  AssertEqual 'http://url.com', meta_notes#notes#GetTextWithinDelimiters('<', '>')
  call cursor(1, 52)
  AssertEqual 'parens', meta_notes#notes#GetTextWithinDelimiters('(', ')')

" ============================================================================
" Delimiter Mismatch
" ============================================================================

Given markdown (Delimiter mismatch):
  Reference: [single-bracket-tag] here

Execute (Delimiter count must match):
  call cursor(1, 15)
  AssertEqual '', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'single-bracket-tag', meta_notes#notes#GetTextWithinDelimiters('[', ']')

" ============================================================================
" No Match Cases
" ============================================================================

Given markdown (No delimiters):
  Just plain text without any delimiters

Execute (No delimiters returns empty):
  call cursor(1, 10)
  AssertEqual '', meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
