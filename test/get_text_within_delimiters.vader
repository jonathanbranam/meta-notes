" Tests for meta_notes#notes#GetTextWithinDelimiters function
" Tests generic delimiter detection with various delimiter types

Execute (Load plugin):
  " Ensure plugin is loaded
  runtime plugin/meta_notes.vim

" ============================================================================
" Double Square Brackets [[text]]
" ============================================================================

Given markdown (Wiki-style link with double square brackets):
  See related: [[note/path/Filename]] here

Execute (Wiki link - cursor inside text):
  call cursor(1, 20)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'note/path/Filename', result, 'Should extract text from [[...]]'

Execute (Wiki link - cursor on opening delimiter):
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'note/path/Filename', result, 'Should extract when cursor on [['

Execute (Wiki link - cursor on closing delimiter):
  call cursor(1, 35)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'note/path/Filename', result, 'Should extract when cursor on ]]'

Execute (Wiki link - cursor before opening delimiter):
  call cursor(1, 10)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual '', result, 'Should return empty when cursor before [['

Execute (Wiki link - cursor after closing delimiter):
  call cursor(1, 36)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual '', result, 'Should return empty when cursor after ]]'

" ============================================================================
" Single Square Brackets [text]
" ============================================================================

Given markdown (Single square brackets):
  Reference: [some-tag] and more text

Execute (Single brackets - cursor inside text):
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('[', ']')
  AssertEqual 'some-tag', result, 'Should extract text from [...]'

Execute (Single brackets - cursor on opening bracket):
  call cursor(1, 12)
  let result = meta_notes#notes#GetTextWithinDelimiters('[', ']')
  AssertEqual 'some-tag', result, 'Should extract when cursor on ['

Execute (Single brackets - cursor on closing bracket):
  call cursor(1, 21)
  let result = meta_notes#notes#GetTextWithinDelimiters('[', ']')
  AssertEqual 'some-tag', result, 'Should extract when cursor on ]'

Execute (Single brackets - cursor outside):
  call cursor(1, 5)
  let result = meta_notes#notes#GetTextWithinDelimiters('[', ']')
  AssertEqual '', result, 'Should return empty when cursor outside'

" ============================================================================
" Angle Brackets <text>
" ============================================================================

Given markdown (HTML-style link with angle brackets):
  Visit <http://example.com> for details

Execute (Angle brackets - cursor inside URL):
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://example.com', result, 'Should extract URL from <...>'

Execute (Angle brackets - cursor on opening bracket):
  call cursor(1, 7)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://example.com', result, 'Should extract when cursor on <'

Execute (Angle brackets - cursor on closing bracket):
  call cursor(1, 26)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://example.com', result, 'Should extract when cursor on >'

Execute (Angle brackets - cursor before opening):
  call cursor(1, 3)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual '', result, 'Should return empty when before <'

Execute (Angle brackets - cursor after closing):
  call cursor(1, 27)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual '', result, 'Should return empty when after >'

" ============================================================================
" Parentheses (text) - for Markdown link URLs
" ============================================================================

Given markdown (Markdown-style link with parentheses):
  Click [here](https://example.com/page) to continue

Execute (Parentheses - cursor inside URL):
  call cursor(1, 20)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual 'https://example.com/page', result, 'Should extract URL from (...)'

Execute (Parentheses - cursor on opening paren):
  call cursor(1, 13)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual 'https://example.com/page', result, 'Should extract when cursor on ('

Execute (Parentheses - cursor on closing paren):
  call cursor(1, 38)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual 'https://example.com/page', result, 'Should extract when cursor on )'

Execute (Parentheses - cursor in link text, not URL):
  call cursor(1, 9)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual '', result, 'Should return empty when in link text [...]'

Execute (Parentheses - cursor after closing paren):
  call cursor(1, 40)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual '', result, 'Should return empty when after )'

" ============================================================================
" Pipe Symbols |text|
" ============================================================================

Given markdown (Pipe-delimited text):
  Table cell: |important data| and more

Execute (Pipes - cursor inside text):
  call cursor(1, 20)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual 'important data', result, 'Should extract text from |...|'

Execute (Pipes - cursor on opening pipe):
  call cursor(1, 13)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual 'important data', result, 'Should extract when cursor on opening |'

Execute (Pipes - cursor on closing pipe):
  call cursor(1, 28)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual 'important data', result, 'Should extract when cursor on closing |'

Execute (Pipes - cursor before opening):
  call cursor(1, 5)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual '', result, 'Should return empty when before |'

Execute (Pipes - cursor after closing):
  call cursor(1, 30)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual '', result, 'Should return empty when after |'

" ============================================================================
" Multiple Delimiters on Same Line
" ============================================================================

Given markdown (Multiple wiki links):
  Links: [[first/link]] and [[second/link]] here

Execute (Multiple delimiters - cursor in first):
  call cursor(1, 12)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'first/link', result, 'Should extract first link'

Execute (Multiple delimiters - cursor in second):
  call cursor(1, 32)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'second/link', result, 'Should extract second link'

Execute (Multiple delimiters - cursor between them):
  call cursor(1, 25)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual '', result, 'Should return empty when between delimiters'

Given markdown (Multiple angle brackets):
  URLs: <http://first.com> and <http://second.com>

Execute (Multiple angles - cursor in first):
  call cursor(1, 12)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://first.com', result, 'Should extract first URL'

Execute (Multiple angles - cursor in second):
  call cursor(1, 35)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://second.com', result, 'Should extract second URL'

Given markdown (Mixed delimiters):
  Mixed: [[wiki/link]] and <http://url.com> and (parens)

Execute (Mixed - extract wiki link):
  call cursor(1, 12)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'wiki/link', result, 'Should extract wiki link among mixed delimiters'

Execute (Mixed - extract angle bracket URL):
  call cursor(1, 30)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://url.com', result, 'Should extract URL among mixed delimiters'

Execute (Mixed - extract parentheses text):
  call cursor(1, 52)
  let result = meta_notes#notes#GetTextWithinDelimiters('(', ')')
  AssertEqual 'parens', result, 'Should extract parens text among mixed delimiters'

" ============================================================================
" Delimiter Mismatch Tests
" ============================================================================

Given markdown (Single brackets but searching for double):
  Reference: [single-bracket-tag] here

Execute (No match when delimiter count differs - single vs double):
  " Cursor inside [single-bracket-tag]
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual '', result, 'Should return empty when single brackets exist but double brackets requested'

Execute (Verify single brackets still work with correct delimiters):
  " Same line, same position, but using correct delimiters
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('[', ']')
  AssertEqual 'single-bracket-tag', result, 'Should extract with correct single bracket delimiters'

" ============================================================================
" Edge Cases
" ============================================================================

Given markdown (No delimiters):
  Just plain text without any delimiters

Execute (No delimiters - no match):
  call cursor(1, 10)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual '', result, 'Should return empty when no delimiters exist'

Given markdown (Single character within delimiters):
  Short: [[x]] and |y| and <z>

Execute (Single char - wiki link):
  call cursor(1, 10)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'x', result, 'Should extract single character from [[...]]'

Execute (Single char - pipes):
  call cursor(1, 18)
  let result = meta_notes#notes#GetTextWithinDelimiters('|', '|')
  AssertEqual 'y', result, 'Should extract single character from |...|'

Execute (Single char - angles):
  call cursor(1, 26)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'z', result, 'Should extract single character from <...>'

Given markdown (Delimiter at start of line):
  [[at-start]] text

Execute (Delimiter at start):
  call cursor(1, 3)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'at-start', result, 'Should extract when delimiter at line start'

Given markdown (Delimiter at end of line):
  Text [[at-end]]

Execute (Delimiter at end):
  call cursor(1, 10)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'at-end', result, 'Should extract when delimiter at line end'

Given markdown (Special characters in content):
  Link: [[path/to/file_v2.1-beta]] here

Execute (Special chars in content):
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('[[', ']]')
  AssertEqual 'path/to/file_v2.1-beta', result, 'Should handle special chars in content'

Given markdown (URL with query params):
  Visit <http://example.com?foo=bar&baz=qux> now

Execute (URL with special chars):
  call cursor(1, 15)
  let result = meta_notes#notes#GetTextWithinDelimiters('<', '>')
  AssertEqual 'http://example.com?foo=bar&baz=qux', result, 'Should handle URL query params'
