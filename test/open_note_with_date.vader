" Tests for opening notes with correct date extraction from filepath

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir

  " Create directory structure
  call mkdir('plan/daily/26-Q1', 'p')
  call mkdir('plan/week/26-Q1', 'p')
  call mkdir('plan/quarter', 'p')
  call mkdir('plan/year', 'p')
  call mkdir('resource/template', 'p')

  " Create a simple daily template
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/daily/{{date:%y}}-Q{{((date.month-1)//3)+1}}/{{date:%Y-%m-%d %a}}.md"',
    \ '---',
    \ '# Daily Note - {{date}}',
    \ '',
    \ 'Date: {{date:%Y-%m-%d}}',
    \ 'Week Start: {{week_start}}',
    \ 'Quarter: {{quarter}}'
  \ ], 'resource/template/daily.md')

  " Create a simple weekly template
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/week/{{week_start:%y}}-{{quarter}}/{{week_start}}.md"',
    \ '---',
    \ '# Week Plan - {{week_start}}',
    \ '',
    \ 'Week: {{week_start}} to {{week_end}}'
  \ ], 'resource/template/weekly.md')

  " Create a simple quarterly template
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/quarter/{{date:%Y}}-{{quarter}}.md"',
    \ '---',
    \ '# Quarterly Plan - {{date:%Y}} {{quarter}}',
    \ '',
    \ 'Quarter: {{quarter}}'
  \ ], 'resource/template/quarterly.md')

  " Create a simple yearly template
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/year/{{date:%Y}}.md"',
    \ '---',
    \ '# Year Plan - {{date:%Y}}',
    \ '',
    \ 'Year: {{date:%Y}}'
  \ ], 'resource/template/yearly.md')

Execute (Test ExtractDateForTemplate - daily note):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/daily/26-Q1/2026-02-13 Thu.md')
  AssertEqual '2026-02-13', result

Execute (Test ExtractDateForTemplate - weekly note):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/week/26-Q1/2026-02-09.md')
  AssertEqual '2026-02-09', result

Execute (Test ExtractDateForTemplate - quarterly note Q1):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/quarter/2026-Q1.md')
  AssertEqual '2026-01-01', result

Execute (Test ExtractDateForTemplate - quarterly note Q2):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/quarter/2026-Q2.md')
  AssertEqual '2026-04-01', result

Execute (Test ExtractDateForTemplate - quarterly note Q3):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/quarter/2026-Q3.md')
  AssertEqual '2026-07-01', result

Execute (Test ExtractDateForTemplate - quarterly note Q4):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/quarter/2026-Q4.md')
  AssertEqual '2026-10-01', result

Execute (Test ExtractDateForTemplate - yearly note):
  let result = meta_notes#notes#ExtractDateForTemplate('plan/year/2026.md')
  AssertEqual '2026-01-01', result

Execute (Test ExtractDateForTemplate - regular note uses today):
  let result = meta_notes#notes#ExtractDateForTemplate('project/my-project/note.md')
  " Should return today's date
  AssertEqual strftime('%Y-%m-%d'), result

Execute (Test Open daily note from link uses correct date):
  " Create a link to a daily note
  call setline(1, 'Link: [[plan/daily/26-Q1/2026-02-13 Thu]]')
  call cursor(1, 10)

  " Open the note
  MetaNotesOpen

  " Verify we're in the correct file
  Assert expand('%') =~ 'plan/daily/26-Q1/2026-02-13 Thu.md'

  " Verify the template used the correct date (not today)
  let content = join(getline(1, '$'), "\n")
  " Check that the date appears in the content (should be 2026-02-13, not today)
  Assert match(content, '2026-02-13') >= 0
  " Make sure it's not using today's date
  let today = strftime('%Y-%m-%d')
  if today != '2026-02-13'
    Assert match(content, 'Date: ' . today) == -1
  endif

Execute (Test Open weekly note from link uses correct date):
  " Create a link to a weekly note
  enew
  call setline(1, 'Link: [[plan/week/26-Q1/2026-02-09]]')
  call cursor(1, 10)

  " Open the note
  MetaNotesOpen

  " Verify we're in the correct file
  Assert expand('%') =~ 'plan/week/26-Q1/2026-02-09.md'

  " Verify the template used the correct week start date
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '# Week Plan - 2026-02-09 Mon') >= 0
  Assert match(content, 'Week: 2026-02-09') >= 0

Execute (Test Open quarterly note from link uses correct date):
  " Create a link to a quarterly note
  enew
  call setline(1, 'Link: [[plan/quarter/2026-Q1]]')
  call cursor(1, 10)

  " Open the note
  MetaNotesOpen

  " Verify we're in the correct file
  Assert expand('%') =~ 'plan/quarter/2026-Q1.md'

  " Verify the template used the correct quarter
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '# Quarterly Plan - 2026 Q1') >= 0
  Assert match(content, 'Quarter: Q1') >= 0

Execute (Test Open yearly note from link uses correct date):
  " Create a link to a yearly note
  enew
  call setline(1, 'Link: [[plan/year/2026]]')
  call cursor(1, 10)

  " Open the note
  MetaNotesOpen

  " Verify we're in the correct file
  Assert expand('%') =~ 'plan/year/2026.md'

  " Verify the template used the correct year
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '# Year Plan - 2026') >= 0
  Assert match(content, 'Year: 2026') >= 0

Execute (Cleanup - Remove temporary test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
