" Tests for creating notes from templates with :MetaNotesOpen

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('project/test-project', 'p')
  call mkdir('plan/daily/26-Q1', 'p')
  call mkdir('plan/week/26-Q1', 'p')
  call mkdir('plan/quarter', 'p')
  call mkdir('plan/year', 'p')
  call mkdir('resource/template', 'p')

" ============================================================================
" MetaNotesOpen with Folder Templates
" ============================================================================

Execute (MetaNotesOpen uses folder-specific template.md):
  call writefile([
    \ '# Project: {{project_name}}',
    \ '',
    \ '## Goal',
    \ '',
    \ '## Tasks'
  \ ], 'project/test-project/template.md')
  edit test.md
  call setline(1, 'See [[project/test-project/Home]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') == 'project/test-project/Home.md'
  Assert getline(1) == '# Project: test-project'
  Assert getline(3) == '## Goal'

Execute (MetaNotesOpen uses simple header when no template.md exists):
  edit test.md
  call setline(1, 'See [[project/another-note]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') == 'project/another-note.md'
  AssertEqual '# project/another-note', getline(1)

Execute (MetaNotesOpen opens existing file without applying template):
  call writefile(['# Existing Note', '', 'Some content'], 'project/existing-note.md')
  edit test.md
  call setline(1, 'See [[project/existing-note]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') == 'project/existing-note.md'
  AssertEqual '# Existing Note', getline(1)
  AssertEqual 'Some content', getline(3)

Execute (MetaNotesOpen uses template from immediate parent directory):
  call mkdir('project/big-project/submodule', 'p')
  call writefile(['# Submodule Note', '', '## Details'], 'project/big-project/submodule/template.md')
  call writefile(['# Project Note', '', '## Overview'], 'project/big-project/template.md')
  edit test.md
  call setline(1, 'See [[project/big-project/submodule/feature-x]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') == 'project/big-project/submodule/feature-x.md'
  AssertEqual '# Submodule Note', getline(1)
  AssertEqual '## Details', getline(3)

Execute (MetaNotesOpen runs vim blocks from the rendered template):
  call mkdir('project/vim-block', 'p')
  call writefile(['# {{note_name}}', '{{% vim echo "x" %}}',
    \ '{{% vim echo "{{note_name}}" %}}', 'end'], 'project/vim-block/template.md')
  edit test.md
  call setline(1, 'See [[project/vim-block/Note]]')
  call cursor(1, 10)
  MetaNotesOpen
  AssertEqual 'project/vim-block/Note.md', expand('%')
  " :echo output captured by :redir starts with a newline
  AssertEqual ['# Note', '', 'x', '', 'Note', 'end'], getline(1, '$')
  Assert &modified
  Assert !filereadable('project/vim-block/Note.md')

Execute (MetaNotesDaily reports a CLI error without opening a buffer):
  edit test.md
  let original_buffer = bufnr('%')
  let v:errmsg = ''
  silent! MetaNotesDaily 2026-13-45
  AssertEqual original_buffer, bufnr('%')
  Assert v:errmsg =~ 'Invalid date: 2026-13-45'

" ============================================================================
" Date Extraction for Templates
" ============================================================================

Execute (Setup templates for date extraction tests):
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/daily/{{date:%y}}-Q{{((date.month-1)//3)+1}}/{{date:%Y-%m-%d %a}}.md"',
    \ '---',
    \ '# Daily Note - {{date}}',
    \ '',
    \ 'Date: {{date:%Y-%m-%d}}',
    \ 'Week Start: {{week_start}}',
    \ 'Quarter: {{quarter}}'
  \ ], 'resource/template/daily.md')
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/week/{{week_start:%y}}-{{quarter}}/{{week_start}}.md"',
    \ '---',
    \ '# Week Plan - {{week_start}}',
    \ '',
    \ 'Week: {{week_start}} to {{week_end}}'
  \ ], 'resource/template/weekly.md')
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/quarter/{{date:%Y}}-{{quarter}}.md"',
    \ '---',
    \ '# Quarterly Plan - {{date:%Y}} {{quarter}}'
  \ ], 'resource/template/quarterly.md')
  call writefile([
    \ '---',
    \ 'filename_pattern: "plan/year/{{date:%Y}}.md"',
    \ '---',
    \ '# Year Plan - {{date:%Y}}'
  \ ], 'resource/template/yearly.md')

Execute (Test Open daily note from link uses correct date):
  call setline(1, 'Link: [[plan/daily/26-Q1/2026-02-13 Thu]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') =~ 'plan/daily/26-Q1/2026-02-13 Thu.md'
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '2026-02-13') >= 0

Execute (Test Open weekly note with day abbreviation uses correct date):
  enew
  call setline(1, 'Link: [[plan/week/26-Q1/2026-02-02 Mon]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') =~ 'plan/week/26-Q1/2026-02-02 Mon.md'
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '2026-02-02') >= 0

Execute (Test Open quarterly note from link uses correct date):
  enew
  call setline(1, 'Link: [[plan/quarter/2026-Q1]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') =~ 'plan/quarter/2026-Q1.md'
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '# Quarterly Plan - 2026 Q1') >= 0

Execute (Test Open yearly note from link uses correct date):
  enew
  call setline(1, 'Link: [[plan/year/2026]]')
  call cursor(1, 10)
  MetaNotesOpen
  Assert expand('%') =~ 'plan/year/2026.md'
  let content = join(getline(1, '$'), "\n")
  Assert match(content, '# Year Plan - 2026') >= 0

Execute (MetaNotesDaily buffer saves to what the CLI would write):
  call writefile(['# {{date}}', '', '{{% shell echo hi %}}', 'end'], 'resource/template/daily.md')
  MetaNotesDaily 2026-03-02
  AssertEqual 'plan/daily/26-Q1/2026-03-02 Mon.md', expand('%')
  Assert !filereadable(expand('%'))
  let expected = system(shellescape(meta_notes#template#GetPluginRoot() . '/bin/meta-notes')
    \ . ' --root . note daily 2026-03-02 --render')
  write
  AssertEqual expected, join(readfile(expand('%'), 'b'), "\n")
  AssertEqual "# 2026-03-02 Mon\n\nhi\n\nend\n", expected

Execute (Cleanup - Remove temporary test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
