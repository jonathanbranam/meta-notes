" Subset of tests to verify functionality

Execute (Load plugin):
  runtime plugin/meta_notes.vim

Execute (Setup test environment):
  let g:test_root = tempname()
  call mkdir(g:test_root . '/note/path', 'p')
  call writefile(['# Sample Note', '', 'This is a test note.'],
        \ g:test_root . '/note/path/Filename.md')
  let g:original_dir = getcwd()
  execute 'cd' g:test_root

Given markdown (Note with wiki-style link):
  # My Notes

  See related: [[note/path/Filename]]

  More content here.

Execute (Open note with cursor inside brackets):
  execute 'cd' g:test_root
  call cursor(3, 20)
  MetaNotesOpen
  let expected_file = resolve(g:test_root . '/note/path/Filename.md')
  let current_file = resolve(expand('%:p'))
  AssertEqual expected_file, current_file, 'Should open the correct note file'
  AssertEqual '# Sample Note', getline(1), 'Should contain the note content'

Execute (Cleanup):
  execute 'cd' g:original_dir
  call delete(g:test_root, 'rf')
  unlet g:test_root
  unlet g:original_dir
