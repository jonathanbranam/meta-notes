" Test: Opening a note in folder with template uses the template
Execute (MetaNotesOpen should use folder-specific template):
  " Create a folder with a template
  call mkdir('test_folder/project', 'p')
  call writefile([
    \ '# Project: {{date}}',
    \ '',
    \ '## Description',
    \ '',
    \ '## Tasks'
  \ ], 'test_folder/project/template.md')

  " Create a wiki link and open it
  call setline(1, 'See [[test_folder/project/my-project]]')
  call cursor(1, 10)
  MetaNotesOpen

  " Check that the note was created with the template
  let lines = getline(1, '$')
  Assert match(lines[0], '^# Project:') >= 0
  Assert match(lines[2], '^## Description') >= 0
  Assert match(lines[4], '^## Tasks') >= 0

  " Close and clean up
  bwipeout!

" Test: Opening a note without template uses simple header
Execute (MetaNotesOpen should use simple header when no template):
  " Create a wiki link and open it
  call setline(1, 'See [[test_folder/simple-note]]')
  call cursor(1, 10)
  MetaNotesOpen

  " Check that the note was created with simple header
  let lines = getline(1, '$')
  AssertEqual '# test_folder/simple-note', lines[0]
  AssertEqual '', lines[1]

  " Close and clean up
  bwipeout!

" ============================================================================
" Tests for ExecuteCommand function
" ============================================================================

" Test: ExecuteCommand with vim command (success)
Execute (ExecuteCommand should execute vim commands successfully):
  let context = {'date': '2026-02-14'}
  " Create a simple vim command that sets a variable
  let result = meta_notes#template#ExecuteCommand('{{% vim let g:test_var = "success" %}}', context)

  " The vim command should have executed and set the variable
  AssertEqual 'success', g:test_var

  " Clean up
  unlet g:test_var

" Test: ExecuteCommand with shell command (success)
Execute (ExecuteCommand should execute shell commands successfully):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% shell echo "Hello from shell" %}}', context)

  " Result should contain the shell output (with trailing newline)
  AssertEqual "Hello from shell\n", result

" Test: ExecuteCommand with python command (success)
Execute (ExecuteCommand should execute python commands successfully):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% python -c "print(2 + 2)" %}}', context)

  " Result should contain "4" with newline
  AssertEqual "4\n", result

" Test: ExecuteCommand resolves scripts/ paths relative to plugin root
Execute (ExecuteCommand should resolve scripts/ paths relative to plugin root):
  " Create a test script in the plugin's scripts directory
  let plugin_root = meta_notes#template#GetPluginRoot()
  let test_script_path = plugin_root . '/scripts/test_script.py'
  call mkdir(plugin_root . '/scripts', 'p')
  call writefile(['print("test_output")'], test_script_path)

  " Execute the script using a relative path
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% python scripts/test_script.py %}}', context)

  " Result should contain the script output
  AssertEqual "test_output\n", result

  " Clean up
  call delete(test_script_path)

" Test: ExecuteCommand with shell command (failure)
Execute (ExecuteCommand should handle shell command failures):
  let context = {'date': '2026-02-14'}
  " Use a command that will fail
  let result = meta_notes#template#ExecuteCommand('{{% shell exit 1 %}}', context)

  " Result should be an HTML comment with error details
  Assert match(result, '^<!-- Command failed:') >= 0
  Assert match(result, '{{% shell exit 1 %}}') >= 0

" Test: ExecuteCommand with python command (failure)
Execute (ExecuteCommand should handle python command failures):
  let context = {'date': '2026-02-14'}
  " Use a python command that will fail
  let result = meta_notes#template#ExecuteCommand('{{% python -c "import sys; sys.exit(1)" %}}', context)

  " Result should be an HTML comment with error details
  Assert match(result, '^<!-- Command failed:') >= 0
  Assert match(result, '{{% python') >= 0

" Test: ExecuteCommand processes variables in commands
Execute (ExecuteCommand should process variables before executing):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% shell echo "{{date}}" %}}', context)

  " The {{date}} should be replaced before execution
  AssertEqual "2026-02-14 Sat\n", result

" Test: ExecuteCommand processes formatted dates in commands
Execute (ExecuteCommand should handle formatted dates in command arguments):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% shell echo "{{date:%Y-%m-%d}}" %}}', context)

  " The {{date:%Y-%m-%d}} should be replaced with just the date
  AssertEqual "2026-02-14\n", result

" Test: ExecuteCommand with unknown command type
Execute (ExecuteCommand should handle unknown command types):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ExecuteCommand('{{% unknown some command %}}', context)

  " Result should indicate unknown command type
  Assert match(result, 'Unknown command type') >= 0

" Test: ExecuteCommand with malformed syntax
Execute (ExecuteCommand should handle malformed command syntax):
  let context = {'date': '2026-02-14'}
  " Missing closing %}}
  let result = meta_notes#template#ExecuteCommand('{{% vim echo "test"', context)

  " Should return the line unchanged if pattern doesn't match
  AssertEqual '{{% vim echo "test"', result

" ============================================================================
" End-to-end test with vim command in template
" ============================================================================

" Test: ProcessTemplate executes vim command in template
Execute (ProcessTemplate should execute vim commands end-to-end):
  " Create a template with a vim command that produces capturable output
  " Use 'version' as a simple command that produces output via redir
  call writefile([
    \ '# Template with Vim Command',
    \ '',
    \ '{{% vim let g:test_output = "Generated by vim" | echo g:test_output %}}',
    \ '',
    \ 'Footer text'
  \ ], 'test_folder/template_with_vim_cmd.md')

  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessTemplate('test_folder/template_with_vim_cmd.md', context)

  " The vim command executes but echo may not produce redir-capturable output
  " So just verify the template was processed and the footer exists
  AssertEqual '# Template with Vim Command', result[0]
  Assert index(result, 'Footer text') >= 0

  " Verify the vim command actually executed by checking the variable
  AssertEqual 'Generated by vim', g:test_output

  " Clean up
  unlet g:test_output

" Test: ProcessTemplate executes shell command in template
Execute (ProcessTemplate should execute shell commands end-to-end):
  " Create a template with a shell command
  call writefile([
    \ '# Tasks for {{date}}',
    \ '',
    \ '{{% shell echo "- Task from shell" %}}',
    \ '',
    \ 'End'
  \ ], 'test_folder/template_with_shell_cmd.md')

  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessTemplate('test_folder/template_with_shell_cmd.md', context)

  " Check the results
  AssertEqual '# Tasks for 2026-02-14 Sat', result[0]
  AssertEqual '', result[1]
  AssertEqual '- Task from shell', result[2]
  AssertEqual '', result[3]
  AssertEqual '', result[4]
  AssertEqual 'End', result[5]

" Test: ProcessTemplate handles command failures gracefully
Execute (ProcessTemplate should handle command failures with error comments):
  " Create a template with a failing command
  call writefile([
    \ '# Template',
    \ '{{% shell this-command-does-not-exist %}}',
    \ 'After error'
  \ ], 'test_folder/template_with_error.md')

  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessTemplate('test_folder/template_with_error.md', context)

  " Check that error is captured as HTML comment
  AssertEqual '# Template', result[0]
  Assert match(result[1], '^<!-- Command failed:') >= 0
  " The error message may span multiple lines, so find "After error"
  Assert index(result, 'After error') >= 0

Execute (Cleanup - Remove temporary test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
