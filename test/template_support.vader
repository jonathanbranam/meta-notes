" Tests for template support (folder-specific and standard templates)

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('test_folder', 'p')

" Test: FindTemplate function finds folder-specific template
Execute (FindTemplate should find folder-specific template.md):
  " Create a folder-specific template
  call mkdir('test_folder/subfolder', 'p')
  call writefile(['# Folder Template', ''], 'test_folder/subfolder/template.md')

  " Test finding the template
  let result = meta_notes#template#FindTemplate('test_folder/subfolder/note.md')
  AssertEqual 'test_folder/subfolder/template.md', result

" Test: FindTemplate function finds standard template when no folder template exists
Execute (FindTemplate should find standard template when no folder template):
  " Create the standard template directory and file
  call mkdir('resource/template', 'p')
  call writefile(['# Daily Template'], 'resource/template/daily.md')

  " Test finding daily template
  let result = meta_notes#template#FindTemplate('resource/plan/daily/26-Q1/2026-02-14.md', 'daily')
  AssertEqual 'resource/template/daily.md', result

" Test: FindTemplate returns empty string when no template found
Execute (FindTemplate should return empty string when no template found):
  " Create a test file path in a folder without template
  call mkdir('test_folder/no_template', 'p')

  " Test with a folder that has no template and no template type
  let result = meta_notes#template#FindTemplate('test_folder/no_template/note.md')
  AssertEqual '', result

" Test: FindTemplate auto-detects daily template from path
Execute (FindTemplate should auto-detect daily template from plan/daily path):
  " Create the daily template
  call mkdir('resource/template', 'p')
  call writefile(['# Daily Template'], 'resource/template/daily.md')

  " Test auto-detection without providing template_type
  let result = meta_notes#template#FindTemplate('resource/plan/daily/26-Q1/2026-02-14.md')
  AssertEqual 'resource/template/daily.md', result

" Test: FindTemplate auto-detects weekly template from path
Execute (FindTemplate should auto-detect weekly template from plan/week path):
  " Create the weekly template
  call writefile(['# Weekly Template'], 'resource/template/weekly.md')

  " Test auto-detection without providing template_type
  let result = meta_notes#template#FindTemplate('resource/plan/week/26-Q1/2026-02-09.md')
  AssertEqual 'resource/template/weekly.md', result

" Test: FindTemplate auto-detects quarterly template from path
Execute (FindTemplate should auto-detect quarterly template from plan/quarter path):
  " Create the quarterly template
  call writefile(['# Quarterly Template'], 'resource/template/quarterly.md')

  " Test auto-detection without providing template_type
  let result = meta_notes#template#FindTemplate('resource/plan/quarter/2026-Q1.md')
  AssertEqual 'resource/template/quarterly.md', result

" Test: FindTemplate auto-detects yearly template from path
Execute (FindTemplate should auto-detect yearly template from plan/year path):
  " Create the yearly template
  call writefile(['# Yearly Template'], 'resource/template/yearly.md')

  " Test auto-detection without providing template_type
  let result = meta_notes#template#FindTemplate('resource/plan/year/2026.md')
  AssertEqual 'resource/template/yearly.md', result

" Test: ProcessVariables replaces simple date variables
Execute (ProcessVariables should replace {{date}} variable):
  let context = {'date': '2026-02-14', 'today': '2026-02-14'}
  let result = meta_notes#template#ProcessVariables('Today is {{date}}', context)
  AssertEqual 'Today is 2026-02-14 Sat', result

" Test: ProcessVariables handles date formatting
Execute (ProcessVariables should handle date formatting):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessVariables('{{date:%A, %B %d, %Y}}', context)
  AssertEqual 'Saturday, February 14, 2026', result

" Test: ProcessVariables handles date arithmetic
Execute (ProcessVariables should handle date arithmetic):
  let context = {'today': '2026-02-14'}
  let result = meta_notes#template#ProcessVariables('Tomorrow: {{today+1:%Y-%m-%d}}', context)
  AssertEqual 'Tomorrow: 2026-02-15', result

  let result2 = meta_notes#template#ProcessVariables('Yesterday: {{today-1:%Y-%m-%d}}', context)
  AssertEqual 'Yesterday: 2026-02-13', result2

" Test: ProcessVariables handles week_start and week_end
Execute (ProcessVariables should handle week variables):
  let context = {'week_start': '2026-02-09', 'week_end': '2026-02-15'}
  let result = meta_notes#template#ProcessVariables('Week: {{week_start}} to {{week_end:%Y-%m-%d}}', context)
  AssertEqual 'Week: 2026-02-09 Mon to 2026-02-15', result

" Test: ProcessVariables handles quarter variable
Execute (ProcessVariables should handle quarter variable):
  let context = {'date': '2026-02-14', 'quarter': 'Q1'}
  let result = meta_notes#template#ProcessVariables('Quarterly Plan: {{date:%Y}}-{{quarter}}', context)
  AssertEqual 'Quarterly Plan: 2026-Q1', result

  let context_q3 = {'date': '2026-08-15', 'quarter': 'Q3'}
  let result_q3 = meta_notes#template#ProcessVariables('Quarter: {{quarter}}', context_q3)
  AssertEqual 'Quarter: Q3', result_q3

" Test: ProcessVariables replaces undefined variables with error comment
Execute (ProcessVariables should replace undefined variables with error comment):
  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessVariables('Date: {{date}}, Name: {{name}}', context)
  AssertEqual 'Date: 2026-02-14 Sat, Name: <!-- ERROR: Unknown variable "name" -->', result

" Test: ProcessVariables replaces {{project_name}} when inside project folder
Execute (ProcessVariables should replace {{project_name}} with project folder name):
  let context = {'filepath': 'project/my-project/subfolder/Note.md'}
  let result = meta_notes#template#ProcessVariables('Project: {{project_name}}', context)
  AssertEqual 'Project: my-project', result

" Test: ProcessVariables handles {{project_name}} when not in project folder
Execute (ProcessVariables should handle {{project_name}} when not in project folder):
  let context = {'filepath': 'area/health/note.md'}
  let result = meta_notes#template#ProcessVariables('Project: {{project_name}}', context)
  AssertEqual 'Project: <!-- Not in project folder -->', result

" Test: ProcessTemplate skips YAML frontmatter
Execute (ProcessTemplate should skip YAML frontmatter):
  " Create a template with frontmatter
  call writefile([
    \ '---',
    \ 'filename_pattern: "test"',
    \ '---',
    \ '# Test Template',
    \ 'Date: {{date}}'
  \ ], 'test_folder/template_with_frontmatter.md')

  let context = {'date': '2026-02-14'}
  let result = meta_notes#template#ProcessTemplate('test_folder/template_with_frontmatter.md', context)

  " Should not include frontmatter lines
  AssertEqual 2, len(result)
  AssertEqual '# Test Template', result[0]
  AssertEqual 'Date: 2026-02-14 Sat', result[1]

" Test: CreateContext creates proper context dictionary
Execute (CreateContext should create context with all required variables):
  let context = meta_notes#template#CreateContext('2026-02-14', 'test/note.md')

  " Verify all expected keys exist
  Assert has_key(context, 'date')
  Assert has_key(context, 'today')
  Assert has_key(context, 'week_start')
  Assert has_key(context, 'week_end')
  Assert has_key(context, 'quarter')
  Assert has_key(context, 'filepath')

  " Verify values
  AssertEqual '2026-02-14', context['date']
  AssertEqual '2026-02-09', context['week_start']
  AssertEqual '2026-02-15', context['week_end']
  AssertEqual 'Q1', context['quarter']
  AssertEqual 'test/note.md', context['filepath']

" Test: CreateContext with project filepath
Execute (CreateContext should include filepath for project path):
  let context = meta_notes#template#CreateContext('2026-02-14', 'project/my-project/subfolder/note.md')

  " Verify filepath is included
  Assert has_key(context, 'filepath')
  AssertEqual 'project/my-project/subfolder/note.md', context['filepath']

" Test: CreateContext calculates correct quarter for Q1
Execute (CreateContext should calculate Q1 for January-March):
  let context_jan = meta_notes#template#CreateContext('2026-01-15', 'test/note.md')
  AssertEqual 'Q1', context_jan['quarter']

  let context_feb = meta_notes#template#CreateContext('2026-02-15', 'test/note.md')
  AssertEqual 'Q1', context_feb['quarter']

  let context_mar = meta_notes#template#CreateContext('2026-03-15', 'test/note.md')
  AssertEqual 'Q1', context_mar['quarter']

