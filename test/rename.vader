" Tests for MetaNotesRename command

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('project', 'p')

" Test: Rename file with just filename (same directory)
Execute (MetaNotesRename should rename file in same directory):
  " Create a test file and open it
  call writefile(['# Original Name'], 'project/test-rename-original.md')
  edit project/test-rename-original.md

  " Rename to new name
  call meta_notes#file_ops#Rename('test-rename-new')

  " Verify file was renamed
  Assert filereadable('project/test-rename-new.md')
  Assert !filereadable('project/test-rename-original.md')

  " Verify buffer updated
  AssertEqual 'project/test-rename-new.md', expand('%:p:.')

  " Close buffer
  bwipeout!

" Test: Rename with .md extension
Execute (MetaNotesRename should handle .md extension):
  " Create a test file
  call writefile(['# Test'], 'project/test-rename-ext.md')
  edit project/test-rename-ext.md

  " Rename with .md extension
  call meta_notes#file_ops#Rename('test-rename-newext.md')

  " Verify renamed correctly (no double .md)
  Assert filereadable('project/test-rename-newext.md')
  Assert !filereadable('project/test-rename-newext.md.md')

  bwipeout!

" Test: Rename to different directory
Execute (MetaNotesRename should move file to different directory):
  " Create test directories
  call mkdir('project/test-rename-source', 'p')
  call mkdir('project/test-rename-dest', 'p')
  call writefile(['# Move Me'], 'project/test-rename-source/file.md')

  " Open the file
  edit project/test-rename-source/file.md

  " Rename with path
  call meta_notes#file_ops#Rename('project/test-rename-dest/moved-file')

  " Verify file moved
  Assert filereadable('project/test-rename-dest/moved-file.md')
  Assert !filereadable('project/test-rename-source/file.md')

  " Verify buffer updated
  AssertEqual 'project/test-rename-dest/moved-file.md', expand('%:p:.')

  bwipeout!

" Test: Cannot rename to existing file
Execute (MetaNotesRename should fail if target exists):
  " Create two files
  call writefile(['# File 1'], 'project/test-rename-file1.md')
  call writefile(['# File 2'], 'project/test-rename-file2.md')

  " Open file1
  edit project/test-rename-file1.md

  " Try to rename to file2 (should fail)
  try
    call meta_notes#file_ops#Rename('test-rename-file2')
    " If we get here, the function didn't throw an error
    AssertEqual 1, 0, 'Expected error but function succeeded'
  catch /Target file already exists/
    " Expected error caught
  endtry

  " Original files should still exist
  Assert filereadable('project/test-rename-file1.md')
  Assert filereadable('project/test-rename-file2.md')

  bwipeout!

" Test: Rename creates target directory if needed
Execute (MetaNotesRename should create target directory):
  " Create source file
  call writefile(['# Test'], 'project/test-rename-createdir.md')
  edit project/test-rename-createdir.md

  " Rename to path in non-existent directory
  call meta_notes#file_ops#Rename('project/test-rename-newdir/subdir/file')

  " Verify directory created and file moved
  Assert isdirectory('project/test-rename-newdir/subdir')
  Assert filereadable('project/test-rename-newdir/subdir/file.md')
  Assert !filereadable('project/test-rename-createdir.md')

  bwipeout!

" Test: Rename with no buffer file fails
Execute (MetaNotesRename should fail with no file):
  " Create a new buffer with no file
  enew

  " Try to rename (should fail)
  try
    call meta_notes#file_ops#Rename('test')
    AssertEqual 1, 0, 'Expected error but function succeeded'
  catch /No file associated with current buffer/
    " Expected error caught
  endtry

  bwipeout!

" Test: Rename updates wiki-links in other files
Execute (MetaNotesRename should update wiki-links when renaming):
  " Create a file that will be renamed
  call mkdir('project/test-links', 'p')
  call writefile(['# Target File'], 'project/test-links/target.md')

  " Create files with wiki-links to the target
  call writefile(['# File 1', '', 'See [[project/test-links/target]]'], 'project/file1.md')
  call writefile(['# File 2', '', 'Link: [[project/test-links/target]]'], 'project/file2.md')
  call writefile(['# File 3', '', 'No links here'], 'project/file3.md')

  " Open and rename the target file
  edit project/test-links/target.md
  call meta_notes#file_ops#Rename('project/test-links/renamed-target')

  " Verify wiki-links were updated
  let file1_content = readfile('project/file1.md')
  Assert match(join(file1_content, "\n"), '\[\[project/test-links/renamed-target\]\]') >= 0, 'file1 should have updated link'
  Assert match(join(file1_content, "\n"), '\[\[project/test-links/target\]\]') == -1, 'file1 should not have old link'

  let file2_content = readfile('project/file2.md')
  Assert match(join(file2_content, "\n"), '\[\[project/test-links/renamed-target\]\]') >= 0, 'file2 should have updated link'

  " File 3 should be unchanged
  let file3_content = readfile('project/file3.md')
  AssertEqual '# File 3', file3_content[0]
  AssertEqual 'No links here', file3_content[2]

  bwipeout!

" Test: Rename updates wiki-links when moving to different directory
Execute (MetaNotesRename should update wiki-links when moving directories):
  " Create source and destination directories
  call mkdir('project/source', 'p')
  call mkdir('project/destination', 'p')
  call writefile(['# Moving File'], 'project/source/moveme.md')

  " Create file with wiki-link
  call writefile(['# Reference', '', 'Link: [[project/source/moveme]]'], 'project/ref.md')

  " Rename/move the file
  edit project/source/moveme.md
  call meta_notes#file_ops#Rename('project/destination/moved')

  " Verify wiki-link updated
  let ref_content = readfile('project/ref.md')
  Assert match(join(ref_content, "\n"), '\[\[project/destination/moved\]\]') >= 0, 'Link should be updated to new path'
  Assert match(join(ref_content, "\n"), '\[\[project/source/moveme\]\]') == -1, 'Old link should be removed'

  bwipeout!

" Test: Rename handles wiki-links with subpaths
Execute (MetaNotesRename should preserve subpaths in wiki-links):
  " Create a folder with a file
  call mkdir('project/folder', 'p')
  call writefile(['# Folder Index'], 'project/folder/index.md')

  " Create file with link to folder and subpath
  call writefile(['# Links', '', 'Folder: [[project/folder]]', 'Index: [[project/folder/index]]'], 'project/links.md')

  " Rename the folder by renaming a file in it and moving
  edit project/folder/index.md
  call meta_notes#file_ops#Rename('project/renamed-folder/index')

  " Verify wiki-links updated
  let links_content = readfile('project/links.md')
  let content_str = join(links_content, "\n")
  Assert match(content_str, '\[\[project/renamed-folder/index\]\]') >= 0, 'Subpath link should be updated'

  bwipeout!

" Test: Rename updates header when it matches old path
Execute (MetaNotesRename should update header if it matches old path):
  " Create a file with header matching its path
  call mkdir('project/test-header', 'p')
  call writefile(['# project/test-header/original', '', 'Some content'], 'project/test-header/original.md')

  " Rename the file
  edit project/test-header/original.md
  call meta_notes#file_ops#Rename('project/test-header/renamed')

  " Verify header was updated
  let content = readfile('project/test-header/renamed.md')
  AssertEqual '# project/test-header/renamed', content[0], 'Header should be updated to new path'
  AssertEqual 'Some content', content[2], 'Other content should be unchanged'

  bwipeout!

" Test: Rename preserves header when it doesn't match old path
Execute (MetaNotesRename should preserve custom header):
  " Create a file with custom header
  call mkdir('project/test-custom', 'p')
  call writefile(['# My Custom Title', '', 'Content here'], 'project/test-custom/file.md')

  " Rename the file
  edit project/test-custom/file.md
  call meta_notes#file_ops#Rename('project/test-custom/newname')

  " Verify header was NOT changed
  let content = readfile('project/test-custom/newname.md')
  AssertEqual '# My Custom Title', content[0], 'Custom header should be preserved'

  bwipeout!

" Test: Rename updates header when moving to different directory
Execute (MetaNotesRename should update header when moving directories):
  " Create file with matching header
  call mkdir('project/old-dir', 'p')
  call mkdir('project/new-dir', 'p')
  call writefile(['# project/old-dir/note', '', 'Content'], 'project/old-dir/note.md')

  " Rename/move the file
  edit project/old-dir/note.md
  call meta_notes#file_ops#Rename('project/new-dir/note')

  " Verify header updated to new path
  let content = readfile('project/new-dir/note.md')
  AssertEqual '# project/new-dir/note', content[0], 'Header should reflect new directory path'

  bwipeout!

" Test: Rename handles empty files gracefully
Execute (MetaNotesRename should handle empty files):
  " Create empty file
  call writefile([], 'project/empty.md')

  " Rename it
  edit project/empty.md
  call meta_notes#file_ops#Rename('project/renamed-empty')

  " Should succeed without errors
  Assert filereadable('project/renamed-empty.md'), 'File should be renamed'
  Assert !filereadable('project/empty.md'), 'Old file should not exist'

  bwipeout!

Execute (Cleanup - Remove temporary test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
