Execute (Setup - Create test directory structure):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('project/test-project', 'p')

Execute (MetaNotesOpen uses folder-specific template.md):
  " Create a template in the project folder
  call writefile([
        \ '# Project: {{project_name}}',
        \ '',
        \ '## Goal',
        \ '',
        \ '## Tasks',
        \ '',
        \ '## Notes'
        \ ], 'project/test-project/template.md')

  " Create a note with a wiki link
  edit test.md
  call setline(1, 'See [[project/test-project/Home]]')
  call cursor(1, 10)

  " Open the link (should create new note with template)
  MetaNotesOpen

  " Verify we're in the new file
  Assert expand('%') == 'project/test-project/Home.md', 'Should open the new note'

  " Verify template was applied
  let lines = getline(1, '$')
  Assert lines[0] == '# Project: test-project', 'First line should match template'
  Assert lines[2] == '## Goal', 'Should have Goal section from template'
  Assert lines[4] == '## Tasks', 'Should have Tasks section from template'
  Assert lines[6] == '## Notes', 'Should have Notes section from template'

Execute (MetaNotesOpen uses simple header when no template.md exists):
  " Create a note with a wiki link in a folder without template.md
  edit test.md
  call setline(1, 'See [[project/another-note]]')
  call cursor(1, 10)

  " Open the link (should create new note with simple header)
  MetaNotesOpen

  " Verify we're in the new file
  Assert expand('%') == 'project/another-note.md', 'Should open the new note'

  " Verify simple header was used
  let lines = getline(1, '$')
  Assert lines[0] == '# project/another-note', 'First line should be simple header'
  Assert lines[1] == '', 'Second line should be empty'

Execute (MetaNotesOpen opens existing file without applying template):
  " Create an existing note
  call writefile(['# Existing Note', '', 'Some content'], 'project/existing-note.md')

  " Create a wiki link to it
  edit test.md
  call setline(1, 'See [[project/existing-note]]')
  call cursor(1, 10)

  " Open the link
  MetaNotesOpen

  " Verify we're in the existing file
  Assert expand('%') == 'project/existing-note.md', 'Should open the existing note'

  " Verify content was not modified
  let lines = getline(1, '$')
  Assert lines[0] == '# Existing Note', 'Content should be unchanged'
  Assert lines[2] == 'Some content', 'Content should be unchanged'

Execute (MetaNotesOpen creates parent directories as needed):
  " Create a wiki link with nested path
  edit test.md
  call setline(1, 'See [[area/finance/budget/2026]]')
  call cursor(1, 10)

  " Open the link (should create directories and file)
  MetaNotesOpen

  " Verify we're in the new file
  Assert expand('%') == 'area/finance/budget/2026.md', 'Should create nested file'

  " Verify directory structure was created
  Assert isdirectory('area/finance/budget'), 'Should create parent directories'

  " Verify simple header was used (no template.md in path)
  let lines = getline(1, '$')
  Assert lines[0] == '# area/finance/budget/2026', 'First line should be simple header'

Execute (MetaNotesOpen uses template from immediate parent directory):
  " Create nested directories with template at different levels
  call mkdir('project/big-project/submodule', 'p')
  call writefile(['# Submodule Note', '', '## Details'], 'project/big-project/submodule/template.md')
  call writefile(['# Project Note', '', '## Overview'], 'project/big-project/template.md')

  " Create a note in the submodule directory
  edit test.md
  call setline(1, 'See [[project/big-project/submodule/feature-x]]')
  call cursor(1, 10)

  " Open the link
  MetaNotesOpen

  " Verify we're in the new file
  Assert expand('%') == 'project/big-project/submodule/feature-x.md', 'Should open the new note'

  " Verify the submodule template was used (not parent template)
  let lines = getline(1, '$')
  Assert lines[0] == '# Submodule Note', 'Should use immediate parent template'
  Assert lines[2] == '## Details', 'Should use immediate parent template'

Execute (Cleanup - Remove test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
