" Tests for meta_notes#notes#GetLinkUnderCursor function

Execute (Load plugin):
  runtime plugin/meta_notes.vim

Given markdown (Single link):
  See related: [[note/path/Filename]] here

Execute (Cursor positions - inside, on delimiters, outside):
  " Inside link
  call cursor(1, 20)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetLinkUnderCursor()
  " On opening brackets
  call cursor(1, 15)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetLinkUnderCursor()
  " On closing brackets
  call cursor(1, 35)
  AssertEqual 'note/path/Filename', meta_notes#notes#GetLinkUnderCursor()
  " Before opening
  call cursor(1, 10)
  AssertEqual '', meta_notes#notes#GetLinkUnderCursor()
  " After closing
  call cursor(1, 36)
  AssertEqual '', meta_notes#notes#GetLinkUnderCursor()

Given markdown (Multiple links):
  Links: [[first/link]] and [[second/link]] here

Execute (Multiple links on same line):
  call cursor(1, 12)
  AssertEqual 'first/link', meta_notes#notes#GetLinkUnderCursor()
  call cursor(1, 32)
  AssertEqual 'second/link', meta_notes#notes#GetLinkUnderCursor()
  call cursor(1, 25)
  AssertEqual '', meta_notes#notes#GetLinkUnderCursor()

Given markdown (No links):
  This is just regular text without any links.

Execute (No link returns empty):
  call cursor(1, 10)
  AssertEqual '', meta_notes#notes#GetLinkUnderCursor()

Given markdown (Edge cases):
  [[at-start]] and [[x]] and End [[at-end]]

Execute (Edge cases - position and length):
  " Link at start
  call cursor(1, 3)
  AssertEqual 'at-start', meta_notes#notes#GetLinkUnderCursor()
  " Single character
  call cursor(1, 20)
  AssertEqual 'x', meta_notes#notes#GetLinkUnderCursor()
  " Link at end
  call cursor(1, 40)
  AssertEqual 'at-end', meta_notes#notes#GetLinkUnderCursor()

Given markdown (Special characters and paths):
  See: [[project/feature_v2.1-beta]] and [[area/health/fitness/workout-plan]]

Execute (Special characters and nested paths):
  call cursor(1, 20)
  AssertEqual 'project/feature_v2.1-beta', meta_notes#notes#GetLinkUnderCursor()
  call cursor(1, 55)
  AssertEqual 'area/health/fitness/workout-plan', meta_notes#notes#GetLinkUnderCursor()
