" Tests for meta_notes#notes#GetLinkUnderCursor function
" Tests link detection independent of file opening

Execute (Load plugin):
  " Ensure plugin is loaded
  runtime plugin/meta_notes.vim

Given markdown (Single link with trailing text):
  See related: [[note/path/Filename]] here

Execute (Detect link with cursor inside filename):
  " Position cursor inside the filename (col 20)
  call cursor(1, 20)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'note/path/Filename', result, 'Should extract filename from link'

Execute (Detect link with cursor on opening brackets):
  " Position cursor on the opening [[ (col 15)
  call cursor(1, 15)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'note/path/Filename', result, 'Should extract filename when cursor on [['

Execute (Detect link with cursor on last closing bracket):
  " Position cursor on last ] (col 35)
  call cursor(1, 35)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'note/path/Filename', result, 'Should extract filename when cursor on last ]'

Execute (No link when cursor before opening brackets):
  " Position cursor before [[ (col 10, on the space)
  call cursor(1, 10)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual '', result, 'Should return empty string when cursor before [['

Execute (No link when cursor after closing brackets):
  " Position cursor after ]] (col 36, on the space after ]])
  call cursor(1, 36)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual '', result, 'Should return empty string when cursor after ]]'

Given markdown (Multiple links on same line):
  Links: [[first/link]] and [[second/link]] here

Execute (Detect first link when cursor in first):
  " Position cursor in first link (col 12)
  call cursor(1, 12)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'first/link', result, 'Should extract first link'

Execute (Detect second link when cursor in second):
  " Position cursor in second link (col 32)
  call cursor(1, 32)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'second/link', result, 'Should extract second link'

Execute (No link when cursor between two links):
  " Position cursor in the " and " text between links (col 25)
  call cursor(1, 25)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual '', result, 'Should return empty string when cursor between links'

Given markdown (Line without any links):
  This is just regular text without any links.

Execute (No link on line without brackets):
  " Position cursor anywhere on the line (col 10)
  call cursor(1, 10)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual '', result, 'Should return empty string when no links on line'

Given markdown (Link with special characters):
  See: [[project/feature_v2.1-beta]]

Execute (Detect link with special characters):
  " Position cursor inside link (col 20)
  call cursor(1, 20)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'project/feature_v2.1-beta', result, 'Should extract link with special chars'

Given markdown (Nested path link):
  Deep link: [[area/health/fitness/workout-plan]]

Execute (Detect deeply nested path):
  " Position cursor inside link (col 25)
  call cursor(1, 25)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'area/health/fitness/workout-plan', result, 'Should extract deep nested path'

Given markdown (Link at start of line):
  [[note-at-start]] of the line

Execute (Detect link at start of line):
  " Position cursor at start (col 3)
  call cursor(1, 3)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'note-at-start', result, 'Should extract link at start of line'

Given markdown (Link at end of line):
  End with [[note-at-end]]

Execute (Detect link at end of line):
  " Position cursor in link (col 15)
  call cursor(1, 15)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'note-at-end', result, 'Should extract link at end of line'

Given markdown (Single character link):
  Quick: [[x]]

Execute (Detect single character link):
  " Position cursor in link (col 10)
  call cursor(1, 10)

  let result = meta_notes#notes#GetLinkUnderCursor()
  AssertEqual 'x', result, 'Should extract single character link'
