" Tests for quarterly and yearly plan functions

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('resource/plan/quarter', 'p')
  call mkdir('resource/plan/year', 'p')

Execute (Test OpenQuarterPlan creates file with correct path for Q1):
  " Open quarterly plan for a date in Q1 2026
  call meta_notes#notes#OpenQuarterPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q1.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Quarterly Plan - 2026 Q1', first_line


Execute (Test OpenQuarterPlan creates file with correct path for Q3):
  " Open quarterly plan for a date in Q3 2026
  call meta_notes#notes#OpenQuarterPlan('2026-07-15')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q3.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Quarterly Plan - 2026 Q3', first_line

Execute (Test OpenQuarterPlan creates directory if it doesn't exist):
  " Remove the directory to test creation
  call delete('resource/plan/quarter', 'rf')

  " Ensure directory doesn't exist
  Assert !isdirectory('resource/plan/quarter')

  " Open quarterly plan
  call meta_notes#notes#OpenQuarterPlan('2026-02-13')

  " Verify directory was created
  Assert isdirectory('resource/plan/quarter')


Execute (Test MetaNotesQuarterPlan command with date argument):
  " Use the command with a date argument
  MetaNotesQuarterPlan 2026-02-13

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q1.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Quarterly Plan - 2026 Q1', first_line


Execute (Test OpenQuarterPlan opens existing file):
  " Create a test file by opening it, writing content, and saving
  execute 'edit! resource/plan/quarter/2026-Q1.md'
  call setline(1, ['# Existing Quarterly Plan', '', 'This is existing content'])
  write

  " Switch to a different buffer
  enew

  " Now open the existing quarterly plan via the function
  call meta_notes#notes#OpenQuarterPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q1.md', expand('%')

  " Verify the existing content is preserved
  let first_line = getline(1)
  AssertEqual '# Existing Quarterly Plan', first_line
  let third_line = getline(3)
  AssertEqual 'This is existing content', third_line


Execute (Test OpenYearPlan creates file with correct path):
  " Open yearly plan for 2026
  call meta_notes#notes#OpenYearPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/year/2026.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Year Plan - 2026', first_line


Execute (Test OpenYearPlan creates file with correct path for different year):
  " Open yearly plan for 2025
  call meta_notes#notes#OpenYearPlan('2025-06-15')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/year/2025.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Year Plan - 2025', first_line


Execute (Test OpenYearPlan creates directory if it doesn't exist):
  " Remove the directory to test creation
  call delete('resource/plan/year', 'rf')

  " Ensure directory doesn't exist
  Assert !isdirectory('resource/plan/year')

  " Open yearly plan
  call meta_notes#notes#OpenYearPlan('2026-02-13')

  " Verify directory was created
  Assert isdirectory('resource/plan/year')


Execute (Test MetaNotesYearPlan command with date argument):
  " Use the command with a date argument
  MetaNotesYearPlan 2026-02-13

  " Verify we're in the correct file
  AssertEqual 'resource/plan/year/2026.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Year Plan - 2026', first_line


Execute (Test OpenYearPlan opens existing file):
  " Create a test file by opening it, writing content, and saving
  execute 'edit! resource/plan/year/2026.md'
  call setline(1, ['# Existing Year Plan', '', 'This is existing content'])
  write

  " Switch to a different buffer
  enew

  " Now open the existing year plan via the function
  call meta_notes#notes#OpenYearPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/year/2026.md', expand('%')

  " Verify the existing content is preserved
  let first_line = getline(1)
  AssertEqual '# Existing Year Plan', first_line
  let third_line = getline(3)
  AssertEqual 'This is existing content', third_line

Execute (Cleanup - Remove temporary test directory):
  execute 'cd -'
  call delete(g:test_dir, 'rf')
