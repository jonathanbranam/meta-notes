Execute (Test OpenQuarterPlan creates directory if it doesn't exist):
  " Clean up any existing directory first
  silent! call delete('resource/plan/quarter', 'rf')

  " Ensure directory doesn't exist
  Assert !isdirectory('resource/plan/quarter')

  " Open quarterly plan
  call meta_notes#notes#OpenQuarterPlan('2026-02-13')

  " Verify directory was created
  Assert isdirectory('resource/plan/quarter')

  " Clean up
  silent! call delete('resource/plan/quarter/2026-Q1.md')
  silent! call delete('resource/plan/quarter', 'd')

Execute (Test MetaNotesQuarterPlan command with date argument):
  " Clean up any existing file first
  silent! call delete('resource/plan/quarter/2026-Q1.md')
  silent! call delete('resource/plan/quarter', 'd')

  " Use the command with a date argument
  MetaNotesQuarterPlan 2026-02-13

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q1.md', expand('%')

  " Verify header was created
  let first_line = getline(1)
  AssertEqual '# Quarterly Plan - 2026 Q1', first_line

  " Clean up
  silent! call delete('resource/plan/quarter/2026-Q1.md')
  silent! call delete('resource/plan/quarter', 'd')

Execute (Test OpenQuarterPlan opens existing file):
  " Clean up first
  silent! call delete('resource/plan/quarter/2026-Q1.md')
  silent! call delete('resource/plan/quarter', 'd')

  " Create a test file by opening it, writing content, and saving
  call mkdir('resource/plan/quarter', 'p')
  execute 'edit! resource/plan/quarter/2026-Q1.md'
  call setline(1, ['# Existing Quarterly Plan', '', 'This is existing content'])
  write

  " Switch to a different buffer
  enew

  " Now open the existing quarterly plan via the function
  call meta_notes#notes#OpenQuarterPlan('2026-02-13')

  " Verify we're in the correct file
  AssertEqual 'resource/plan/quarter/2026-Q1.md', expand('%')

  " Verify the existing content is preserved
  let first_line = getline(1)
  AssertEqual '# Existing Quarterly Plan', first_line
  let third_line = getline(3)
  AssertEqual 'This is existing content', third_line

  " Clean up
  silent! call delete('resource/plan/quarter/2026-Q1.md')
  silent! call delete('resource/plan/quarter', 'd')

