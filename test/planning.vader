" Tests for planning note functions (daily, weekly, quarterly, yearly)

Execute (Setup - Create temporary test directory):
  let g:test_dir = tempname()
  call mkdir(g:test_dir, 'p')
  execute 'cd' g:test_dir
  call mkdir('plan/daily/26-Q1', 'p')
  call mkdir('plan/daily/26-Q3', 'p')
  call mkdir('plan/week/26-Q1', 'p')
  call mkdir('plan/quarter', 'p')
  call mkdir('plan/year', 'p')

" ============================================================================
" Quarter Calculations
" ============================================================================

Execute (Test CalculateQuarter - Q1):
  AssertEqual 'Q1', meta_notes#notes#CalculateQuarter('2026-01-15')
  AssertEqual 'Q1', meta_notes#notes#CalculateQuarter('2026-02-13')
  AssertEqual 'Q1', meta_notes#notes#CalculateQuarter('2026-03-31')

Execute (Test CalculateQuarter - Q2):
  AssertEqual 'Q2', meta_notes#notes#CalculateQuarter('2026-04-01')
  AssertEqual 'Q2', meta_notes#notes#CalculateQuarter('2026-05-15')
  AssertEqual 'Q2', meta_notes#notes#CalculateQuarter('2026-06-30')

Execute (Test CalculateQuarter - Q3):
  AssertEqual 'Q3', meta_notes#notes#CalculateQuarter('2026-07-01')
  AssertEqual 'Q3', meta_notes#notes#CalculateQuarter('2026-08-15')
  AssertEqual 'Q3', meta_notes#notes#CalculateQuarter('2026-09-30')

Execute (Test CalculateQuarter - Q4):
  AssertEqual 'Q4', meta_notes#notes#CalculateQuarter('2026-10-01')
  AssertEqual 'Q4', meta_notes#notes#CalculateQuarter('2026-11-15')
  AssertEqual 'Q4', meta_notes#notes#CalculateQuarter('2026-12-31')

" ============================================================================
" Week Calculations
" ============================================================================

Execute (Test CalculateWeekStart):
  AssertEqual '2026-02-09', meta_notes#notes#CalculateWeekStart('2026-02-09')
  AssertEqual '2026-02-09', meta_notes#notes#CalculateWeekStart('2026-02-10')
  AssertEqual '2026-02-09', meta_notes#notes#CalculateWeekStart('2026-02-13')
  AssertEqual '2026-02-09', meta_notes#notes#CalculateWeekStart('2026-02-15')

Execute (Test CalculateWeekEnd):
  AssertEqual '2026-02-15', meta_notes#notes#CalculateWeekEnd('2026-02-15')
  AssertEqual '2026-02-15', meta_notes#notes#CalculateWeekEnd('2026-02-09')
  AssertEqual '2026-02-15', meta_notes#notes#CalculateWeekEnd('2026-02-13')
  AssertEqual '2026-02-15', meta_notes#notes#CalculateWeekEnd('2026-02-14')

" ============================================================================
" Daily Notes
" ============================================================================

Execute (Test OpenDaily creates file with correct path for Q1):
  call meta_notes#notes#OpenDaily('2026-02-13')
  AssertEqual 'plan/daily/26-Q1/2026-02-13 Fri.md', expand('%')
  AssertEqual '# Daily Note - 2026-02-13 Fri', getline(1)

Execute (Test OpenDaily creates file with correct path for Q3):
  call meta_notes#notes#OpenDaily('2026-07-15')
  AssertEqual 'plan/daily/26-Q3/2026-07-15 Wed.md', expand('%')
  AssertEqual '# Daily Note - 2026-07-15 Wed', getline(1)

Execute (Test OpenDaily creates directory if it doesn't exist):
  call delete('plan/daily/26-Q1', 'rf')
  Assert !isdirectory('plan/daily/26-Q1')
  call meta_notes#notes#OpenDaily('2026-02-13')
  Assert isdirectory('plan/daily/26-Q1')

Execute (Test MetaNotesDaily command with date argument):
  silent! call delete('plan/daily/26-Q1/2026-02-13 Fri.md')
  MetaNotesDaily 2026-02-13
  AssertEqual 'plan/daily/26-Q1/2026-02-13 Fri.md', expand('%')
  AssertEqual '# Daily Note - 2026-02-13 Fri', getline(1)

Execute (Test OpenDaily opens existing file):
  execute 'edit! plan/daily/26-Q1/2026-02-13 Fri.md'
  call setline(1, ['# Existing Daily Note', '', 'This is existing content'])
  write
  enew
  call meta_notes#notes#OpenDaily('2026-02-13')
  AssertEqual 'plan/daily/26-Q1/2026-02-13 Fri.md', expand('%')
  AssertEqual '# Existing Daily Note', getline(1)
  AssertEqual 'This is existing content', getline(3)

