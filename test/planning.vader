" Weekly Plans
" ============================================================================

Execute (Test OpenWeekPlan creates file with correct path):
  call meta_notes#notes#OpenWeekPlan('2026-02-13')
  AssertEqual 'plan/week/26-Q1/2026-02-09.md', expand('%')
  AssertEqual '# Week Plan - 2026-02-09', getline(1)

Execute (Test MetaNotesWeekPlan command with date argument):
  MetaNotesWeekPlan 2026-02-13
  AssertEqual 'plan/week/26-Q1/2026-02-09.md', expand('%')
  AssertEqual '# Week Plan - 2026-02-09', getline(1)

